FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app.py document_cleaning.py ./
# uploads/, history/, restored/ powstaja w cwd -> /data (wolumen)
WORKDIR /data
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "PYTHONPATH=/app exec gunicorn -b 0.0.0.0:${PORT} -w 2 --threads 4 --timeout 300 app:app"]
